# ==============================================================================
# AgriSage AI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure your secrets.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Security & Authentication
# In production (when DEBUG=false), the app refuses to start if JWT_SECRET is a placeholder!
JWT_SECRET=agrisage_insecure_development_secret_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Absolute path to SQLite database will be resolved automatically if omitted)
# Example: sqlite:///C:/Users/varsh/OneDrive/Desktop/agrisage-ai/agrisage.db
DATABASE_URL=

# Seed Account Passwords (Used by scripts/seed.py for non-passwordless roles)
DEMO_EXPERT_PASSWORD=ExpertDemo@2026
DEMO_BUYER_PASSWORD=BuyerDemo@2026
DEMO_ADMIN_PASSWORD=AdminDemo@2026
DEMO_FARMER_PASSWORD=FarmerRamesh@2026

# CORS Policy (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional External API Keys (Graceful DEMO fallbacks provided if omitted)
# Free tier key from Google AI Studio (for optional semantic LLM chat/translation)
GEMINI_API_KEY=

# Government Open Data API Key from data.gov.in (for live AGMARKNET mandi arrivals)
DATA_GOV_IN_API_KEY=

# Hugging Face User Access Token (only needed if downloading gated model weights)
HF_TOKEN=

# Feature Flags & Calibration
ENABLE_DEMO_FALLBACKS=true
DISEASE_CONFIDENCE_THRESHOLD=0.65
WEATHER_CACHE_TTL_MINUTES=30
