# ==============================================================================
# AgriSage AI — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your secrets. NEVER commit .env to git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Security & Authentication
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=agrisage_insecure_development_secret_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite for hackathon evaluation)
DATABASE_URL=sqlite:///./agrisage.db

# CORS Policy (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional External API Keys (Graceful DEMO fallbacks provided if omitted)
# Free tier key from Google AI Studio (for optional semantic LLM chat/translation)
GEMINI_API_KEY=

# Government Open Data API Key from data.gov.in (for live AGMARKNET mandi arrivals)
DATA_GOV_IN_API_KEY=

# Hugging Face User Access Token (only needed if downloading gated model weights)
HF_TOKEN=

# Feature Flags & Calibration
ENABLE_DEMO_FALLBACKS=true
DISEASE_CONFIDENCE_THRESHOLD=0.65
WEATHER_CACHE_TTL_MINUTES=30

